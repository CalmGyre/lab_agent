# Dependency manifests, lockfiles, source code and configuration examples should be tracked.
# Only generated or local files are ignored below.

# Environment variables and local overrides
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
.envrc.local
*.local

# Logs and runtime process files
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock

# JavaScript / TypeScript dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.bun/
.bower-cache/
bower_components/

# Frontend build output and framework caches
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.astro/
.angular/cache/
.vite/
.vite-temp/
.parcel-cache/
.turbo/
.vercel/
.netlify/
.serverless/
.webpack/
.docusaurus/
.cache/
.sass-cache/
*.tsbuildinfo
*.timestamp-*.mjs
*.timestamp-*.js
.eslintcache
.stylelintcache
.prettiercache

# Tests, coverage and profiling output
coverage/
htmlcov/
.nyc_output/
.coverage
.coverage.*
coverage.xml
lcov.info
test-results/
test-reports/
playwright-report/
playwright/.cache/
blob-report/
cypress/videos/
cypress/screenshots/
*.prof
*.lprof

# Python bytecode, virtual environments and tool caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
__pypackages__/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
pip-wheel-metadata/
*.egg-info/
*.egg
.eggs/
wheels/

# Java / Kotlin / Gradle / Maven
*.class
target/
.gradle/
.kotlin/
.mvn/timing.properties
hs_err_pid*
replay_pid*

# .NET / Visual Studio
**/bin/Debug/
**/bin/Release/
obj/
.vs/
TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates
*.nupkg
*.snupkg

# PHP / Composer / PHPUnit
vendor/
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache

# Ruby / Bundler
.bundle/
vendor/bundle/
.byebug_history

# Go test output (keep go.mod and go.sum)
*.test
*.coverprofile

# Local databases and runtime uploads
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
backend/uploads/

# Temporary files and local history
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*~
.history/

# Editors (keep shared VS Code settings, tasks and extensions)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.swp
*.swo

# Operating system files
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
